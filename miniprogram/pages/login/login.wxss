.page {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0 100rpx;
}

.hero-icon {
  font-size: 140rpx;
  background: linear-gradient(135deg, #fff6ee, #ffe8d8);
  border-radius: 50%;
  width: 240rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-top: 40rpx;
  color: #222;
}

.hero-sub {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.login-btns {
  padding: 0 60rpx;
}

.login-btn {
  width: 100%;
  box-sizing: border-box;
}

.dev-btn {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 32rpx;
  padding: 12rpx;
}

.login-tip {
  text-align: center;
  color: #bbb;
  font-size: 22rpx;
  margin-top: auto;
  padding: 40rpx 0 calc(40rpx + env(safe-area-inset-bottom));
}
