<view class="page" wx:if="{{order}}">
  <!-- 状态头部 -->
  <view class="status-header">
    <view class="status-icon">🛵</view>
    <view>
      <view class="status-text">{{order.statusText}}</view>
      <view class="status-sub">
        <block wx:if="{{order.status === 'pending'}}">请尽快完成支付，未支付订单将自动关闭</block>
        <block wx:elif="{{order.status === 'paid'}}">商家正在备餐，请耐心等待</block>
        <block wx:elif="{{order.status === 'delivering'}}">骑手正在配送中，请保持电话畅通</block>
        <block wx:elif="{{order.status === 'completed'}}">订单已完成，感谢您的惠顾</block>
        <block wx:else>订单已取消</block>
      </view>
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="card">
    <view class="addr-name">{{order.address.name}} <text class="addr-phone">{{order.address.phone}}</text></view>
    <view class="addr-detail">{{order.address.province}}{{order.address.city}}{{order.address.district}}{{order.address.detail}}</view>
  </view>

  <!-- 商品明细 -->
  <view class="card">
    <view class="section-title">{{order.shop_name}} <text class="shop-link" bindtap="goShop">进店 ›</text></view>
    <view wx:for="{{order.items}}" wx:key="id" class="order-item">
      <view class="item-name ellipsis">{{item.goods_name}}</view>
      <view class="item-count">×{{item.count}}</view>
      <view class="item-price">¥{{formatPrice(item.price * item.count)}}</view>
    </view>
  </view>

  <!-- 金额明细 -->
  <view class="card">
    <view class="fee-row"><text>商品金额</text><text>¥{{order.goods_amount}}</text></view>
    <view class="fee-row"><text>配送费</text><text>¥{{order.delivery_fee}}</text></view>
    <view class="fee-row total-row"><text>实付金额</text><text class="price">¥{{order.total_price}}</text></view>
    <view class="fee-row remark-row" wx:if="{{order.remark}}"><text>备注</text><text>{{order.remark}}</text></view>
  </view>

  <!-- 订单信息 -->
  <view class="card info-card">
    <view class="fee-row"><text>订单编号</text><text>{{order.order_no}}</text></view>
    <view class="fee-row"><text>下单时间</text><text>{{formatTime(order.created_at)}}</text></view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <block wx:if="{{order.status === 'pending'}}">
      <view class="btn-plain" bindtap="onCancel">取消订单</view>
      <view class="action-primary" bindtap="onPay">立即支付</view>
    </block>
    <block wx:elif="{{order.status === 'paid'}}">
      <view class="btn-plain" bindtap="onCancel">取消订单</view>
    </block>
    <block wx:elif="{{order.status === 'delivering'}}">
      <view class="action-primary" bindtap="onConfirm">确认收货</view>
    </block>
    <block wx:else>
      <view class="btn-plain" bindtap="goHome">去首页逛逛</view>
      <view class="action-primary" bindtap="goShop">再来一单</view>
    </block>
  </view>
</view>
