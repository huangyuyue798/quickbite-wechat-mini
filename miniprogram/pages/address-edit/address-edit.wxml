<view class="page">
  <view class="card form-card">
    <view class="form-row">
      <view class="form-label">收货人</view>
      <input class="form-input" placeholder="姓名" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-row">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" maxlength="11" placeholder="11 位手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-row">
      <view class="form-label">所在地区</view>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange" class="form-picker">
        <view class="picker-value">{{region[0]}} {{region[1]}} {{region[2]}} ›</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="form-label">详细地址</view>
      <input class="form-input" placeholder="街道、小区、门牌号等" value="{{detail}}" bindinput="onDetailInput" />
    </view>
    <view class="form-row">
      <view class="form-label">标签</view>
      <view class="tag-group">
        <view
          wx:for="{{tags}}"
          wx:key="*this"
          class="tag-item {{tagIndex === index ? 'tag-active' : ''}}"
          data-index="{{index}}"
          bindtap="onTagTap"
        >{{item}}</view>
      </view>
    </view>
    <view class="form-row">
      <view class="form-label">设为默认</view>
      <switch checked="{{isDefault}}" color="#ff6b35" bindchange="onDefaultChange" />
    </view>
  </view>

  <view class="save-wrap">
    <view class="btn-primary save-btn {{saving ? 'btn-disabled' : ''}}" bindtap="onSave">
      {{saving ? '保存中...' : '保存地址'}}
    </view>
  </view>
</view>
