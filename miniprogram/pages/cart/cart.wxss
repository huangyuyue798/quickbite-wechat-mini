.cart-list {
  padding-bottom: 40rpx;
}

.shop-group {
  padding: 24rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f2f3f5;
}

.group-name {
  font-size: 30rpx;
  font-weight: 700;
}

.group-total {
  font-size: 26rpx;
  color: #666;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.cart-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #fff6ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.cart-img-real {
  width: 100%;
  height: 100%;
}

.cart-info {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
}

.cart-name {
  font-size: 28rpx;
}

.cart-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.group-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 2rpx solid #f2f3f5;
}

.checkout-btn {
  background: linear-gradient(90deg, #ff8a3d, #ff6b35);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 14rpx 48rpx;
  margin-left: 20rpx;
  font-weight: 600;
}

.clear-all {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 24rpx 0;
}
