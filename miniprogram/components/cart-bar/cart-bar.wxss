.cart-bar {
  display: flex;
  align-items: center;
  background: #2b2b33;
  border-radius: 48rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  margin: 0 20rpx;
}

.cart-icon-wrap {
  position: relative;
}

.cart-icon {
  width: 80rpx;
  height: 80rpx;
  background: #ff6b35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.total {
  flex: 1;
  margin-left: 20rpx;
  color: #fff;
}

.total-empty {
  color: #888;
  font-size: 26rpx;
}

.total-symbol {
  font-size: 26rpx;
}

.total-value {
  font-size: 44rpx;
  font-weight: 700;
}

.action {
  background: linear-gradient(90deg, #ff8a3d, #ff6b35);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 20rpx 44rpx;
}

.action-disabled {
  background: #5a5a63;
  color: #aaa;
}
