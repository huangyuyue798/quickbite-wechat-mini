.shop-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #ffb26b, #ff6b35);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.logo-text {
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
}

.logo-img {
  width: 100%;
  height: 100%;
}

.info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.desc {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0 12rpx;
}

.meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #888;
  margin-top: 6rpx;
}

.meta text {
  margin-right: 20rpx;
}

.rating {
  color: #ff9a2e;
}

.tag {
  background: #fff3e8;
  color: #ff6b35;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  margin-right: 0 !important;
}
