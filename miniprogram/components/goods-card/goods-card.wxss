.goods-card {
  display: flex;
  background: #fff;
  padding: 24rpx;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #fff6ee;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.img-emoji {
  font-size: 72rpx;
}

.img-real {
  width: 100%;
  height: 100%;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.4;
}

.goods-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  line-height: 1.4;
}

.goods-sales {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.goods-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
}

.price {
  color: #ff3b30;
  font-weight: 700;
}

.origin {
  font-size: 22rpx;
  color: #bbb;
  text-decoration: line-through;
  margin-left: 8rpx;
  font-weight: 400;
}

.stepper-wrap {
  display: flex;
  align-items: center;
}

.op-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #ff6b35;
  color: #ff6b35;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.count {
  font-size: 28rpx;
  color: #333;
  margin: 0 16rpx;
  min-width: 40rpx;
  text-align: center;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a3d, #ff6b35);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(255, 107, 53, 0.35);
}
